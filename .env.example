# ---- CRM target ----
CRM_BASE_URL=https://your-crm-host.example.com

# ---- Authenticated checks + business KPIs (optional) ----
# A read-only staff session cookie for the real Business Health KPIs.
# The CRM runs Auth.js v5, so the cookie is __Secure-authjs.session-token (https)
# — NOT next-auth.session-token. It is HttpOnly: copy the Value from DevTools →
# Application → Cookies and paste the whole "name=value" (two = signs on the line):
#   MONITOR_SESSION_COOKIE=__Secure-authjs.session-token=eyJ...
# Use a dedicated READ-ONLY account (see PREREQUISITES.md §2), never super-admin.
# CRM_BASE_URL above must be the bare origin (no /login, no query, no trailing slash).
MONITOR_SESSION_COOKIE=

# ---- Role scoping (RBAC) ----
# Single-operator fallback role (used when MONITOR_USERS is not set).
# One of: super-admin | finance | sales | marketing | hr | support
MONITOR_ROLE=super-admin

# Per-user identity (preferred): the authenticated Basic-Auth user's role drives
# route access AND data scoping. Format: user:pass:role,user2:pass2:role2
# (passwords may not contain ':'). When set, this REPLACES MONITOR_USER/PASSWORD.
# MONITOR_USERS=

# ---- History durability ----
# File JSONL is non-durable/single-instance. Set DATABASE_URL (Postgres) for
# durable, multi-instance-safe KPI history. DATABASE_URL is defined above.

# ---- AWS CloudWatch (optional) ----
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Comma-separated ECS log group(s) holding the CRM app + cron output.
CW_LOG_GROUPS=/ecs/abbey-blue-crm
# CloudWatch Logs filter for surfacing error lines (tune to your logs).
# CW_ERROR_PATTERN=?ERROR ?Exception ?FATAL
# Minutes after a cron's expected time before a missing success = failure.
CW_CRON_GRACE_MINUTES=20

# ---- Alerting (optional) ----
# Any/all channels. Alerts fire on ok->down/warn and on recovery.
ALERT_SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
# Only tiers at/above this severity notify (1=critical only, 2=core+, 3=all).
ALERT_MIN_TIER=2

# --- Local ports (host side only; the container always listens on 4000) ---
# WEB_PORT  host port `docker compose up` publishes for this checkout.
# Worktrees get their own value so two checkouts can run side by side.
WEB_PORT=4000
