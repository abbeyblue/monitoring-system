{
  "family": "crm-monitor",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/crm-monitor-execution-role",
  "taskRoleArn": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/crm-monitor-task-role",
  "containerDefinitions": [
    {
      "name": "crm-monitor",
      "image": "REPLACE_ACCOUNT_ID.dkr.ecr.eu-west-1.amazonaws.com/crm-monitor:latest",
      "essential": true,
      "portMappings": [
        { "name": "http", "containerPort": 4000, "protocol": "tcp", "appProtocol": "http" }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "CRM_BASE_URL", "value": "https://REPLACE_CRM_HOST" },
        { "name": "AWS_REGION", "value": "eu-west-1" },
        { "name": "CW_LOG_GROUPS", "value": "/ecs/abbey-blue-crm" },
        { "name": "ALERT_MIN_TIER", "value": "2" },
        { "name": "MONITOR_USER", "value": "monitor" }
      ],
      "secrets": [
        { "name": "MONITOR_PASSWORD",         "valueFrom": "arn:aws:secretsmanager:eu-west-1:REPLACE_ACCOUNT_ID:secret:crm-monitor/MONITOR_PASSWORD" },
        { "name": "MONITOR_SESSION_COOKIE",   "valueFrom": "arn:aws:secretsmanager:eu-west-1:REPLACE_ACCOUNT_ID:secret:crm-monitor/MONITOR_SESSION_COOKIE" },
        { "name": "ALERT_SLACK_WEBHOOK_URL",  "valueFrom": "arn:aws:secretsmanager:eu-west-1:REPLACE_ACCOUNT_ID:secret:crm-monitor/ALERT_SLACK_WEBHOOK_URL" },
        { "name": "HEARTBEAT_TOKEN",          "valueFrom": "arn:aws:secretsmanager:eu-west-1:REPLACE_ACCOUNT_ID:secret:crm-monitor/HEARTBEAT_TOKEN" },
        { "name": "DATABASE_URL",             "valueFrom": "arn:aws:secretsmanager:eu-west-1:REPLACE_ACCOUNT_ID:secret:crm-monitor/DATABASE_URL" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:4000/api/ping || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/crm-monitor",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "crm-monitor",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
